# ApnaMart (https://apnamart.space) Environment Configuration
VITE_APP_NAME="ApnaMart"
VITE_STORE_CURRENCY="PKR"
VITE_CURRENCY_SYMBOL="Rs."
VITE_FREE_SHIPPING_THRESHOLD=5000
VITE_DEFAULT_DELIVERY_FEE=250

# Centralized Cloud Database & Realtime (Supabase PostgreSQL)
# Obtain these from your Supabase Dashboard: Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-api-key"
